{
  "name": "clawfare-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "npm run api:generate && tsc --noEmit",
    "build": "npm run api:generate && tsc --noEmit && vite build && node ../scripts/inline-web-bundle.mjs && node ../scripts/verify-web-bundle.mjs",
    "lint": "oxlint src vite.config.ts",
    "format": "oxfmt src vite.config.ts",
    "format:check": "oxfmt src/ItineraryViews.tsx && git diff -- src/ItineraryViews.tsx",
    "check": "npm run api:generate && npm run api:check && npm run typecheck && npm run lint && npm run test && npm run format:check",
    "test": "npm run api:generate && node --experimental-strip-types --test src/*.test.ts && npm run guest:test",
    "api:generate": "node ../scripts/generate-openapi.mjs",
    "api:check": "node ../scripts/generate-openapi.mjs --check",
    "guest:build": "npm run build && node ../scripts/build-guest-preview.mjs",
    "guest:check": "node ../scripts/build-guest-preview.mjs",
    "guest:test": "node --test ../scripts/guest-preview.test.mjs"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
