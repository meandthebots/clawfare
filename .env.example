# Copy to a shell, or export before `./gradlew run --args="serve"`.
# The process reads these itself. They are never sent to the browser, never logged, and never written to the cache.

# Google Flights via SerpApi, including departure_token returns and booking_token seller offers.
# About 250 searches a month on the free plan.
SERPAPI_API_KEY=

# Google Flights via SearchAPI. Same offer shape, separate quota.
SEARCHAPI_API_KEY=

# Cached calendar fares. Labelled "cached", not a live price.
TRAVELPAYOUTS_API_TOKEN=

# Duffel test token (duffel_test_…). Every offer is labelled mock and is never a real price.
DUFFEL_ACCESS_TOKEN=

# Optional. The database is the source of truth (default ~/.clawfare/data.db).
# Raw provider bodies live in the provider_cache table so a search can be parsed again without another call.
# CLAWFARE_PORT=8080
# CLAWFARE_DB=
